# Build-and-test settings only. The oled CLI reads no environment
# configuration: every runtime setting lives in the config file
# (default ~/.oled/config.json; any command takes --conf <path>).
# The CLI no longer loads .env; scripts that need these load it themselves.

# Optional. The live-OCR test suites run only when this names a reachable
# OpenAI-compatible endpoint, version segment included. Read by tests only.
TEST_OCR_BASE_URL=

# Optional. Model id served there, as the server spells it.
TEST_OCR_MODEL=

# Optional. API key for that endpoint, if it requires one.
TEST_OCR_API_KEY=

# Optional. Test-only: set to 1 to let `npm run integration` reuse the
# existing dist/ instead of rebuilding.
E2E_SKIP_BUILD=

# Required, all four, by `npm run publish:skills` only — Cloudflare R2
# credentials for uploading skills/ to cdn.openledger.sh. Never read by the
# oled CLI.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
