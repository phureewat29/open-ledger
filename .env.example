# OpenLedger environment variables. Copy this file to `.env` and fill in the
# values you need. Dotenv reads `.env` from the current working directory,
# the directory you run `oled` from, not ~/.oled.

# Optional. Relocates the entire ~/.oled directory. Individual
# OLED_* overrides below still win for their own paths.
# Default: ~/.oled
OLED_DIR=

# Optional. Database file path.
# Default: ~/.oled/db.sqlite
OLED_DB_PATH=

# Optional. Statement drop folder.
# Default: ~/.oled/data
OLED_DATA_DIR=

# Optional. Scratch space for the extracted text and page images handed to
# external agent CLIs.
# Default: ~/.oled/cache
OLED_CACHE_DIR=

# Optional. OCR is off until this is set. OpenAI-compatible OCR endpoint base
# URL, including its version segment, e.g. http://127.0.0.1:1234/v1. A
# non-local URL sends statement page images off this machine.
# Default: unset (OCR off)
OLED_OCR_BASE_URL=

# Optional. Model id served at OLED_OCR_BASE_URL; does nothing until
# OLED_OCR_BASE_URL is set. The id picks the built-in prompt, sampling, and
# render settings: typhoon and lighton model families are recognized by id;
# any other id is sent as-is with the typhoon settings.
# Default: typhoon-ocr1.5
OLED_OCR_MODEL=

# Optional. API key for the OCR endpoint, if it requires one. Set it here or
# in the shell: `oled config` has no flag for it.
# Default: unset
OLED_OCR_API_KEY=

# Required, all four, by `npm run publish:skills` only — Cloudflare R2
# credentials for uploading skills/ to cdn.openledger.sh. Never read by the
# oled CLI.
# Default: unset
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
