# Any OpenAI-compatible server, local or hosted, e.g.:
#   LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=unused
#   LLM_BASE_URL=http://localhost:1234/v1   LLM_API_KEY=unused
#
# The model must support tool calling — check your endpoint's model listing
# (or its docs) before running. A statement reaches it as extracted text, or
# as page images when the harness has no text to give; the eval is entirely
# tool-driven and a model without tool calling cannot run at all.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=unused
LLM_MODEL=

# Stream the response. Leave true unless the endpoint reports token usage only
# on non-streamed replies.
LLM_STREAM=true

LLM_TIMEOUT_MS=600000

# What the model accepts, as a comma list of text and image. Auto-detected on
# an endpoint that publishes a compatible model list; set it for any other
# endpoint, or to correct one that reports itself wrongly.
# LLM_INPUT_MODALITIES=text,image

# The context budget the runner trims tool results against. Leave it unset where
# the endpoint publishes the model's window: 80% of that window is derived per
# model, so one .env fits every model. Set it for an endpoint that publishes no
# window and a model smaller than the 28000-token default. A trim is harness
# interference, so the goal is for trims never to happen.
# CONTEXT_BUDGET_TOKENS=8000
