# Any OpenAI-compatible endpoint:
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_API_KEY=sk-or-v1-...
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1    LLM_API_KEY=ollama
#   LM Studio   LLM_BASE_URL=http://localhost:1234/v1     LLM_API_KEY=lm-studio
#
# The model must support tool calling, and must accept image or file input: a
# statement reaches it as page images or as a PDF. On OpenRouter, check that
# "tools" is in a model's supported_parameters at
# https://openrouter.ai/api/v1/models — the eval is entirely tool-driven and a
# model without it cannot run at all.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=unused
LLM_MODEL=google/gemma-4-31b-it

# Stream the response. Leave true unless the endpoint reports token usage only
# on non-streamed replies.
LLM_STREAM=true

LLM_TIMEOUT_MS=600000

# What the model accepts, as a comma list of text, image, and file. On OpenRouter
# this is read from the model list; set it for any other endpoint, or to correct
# one that reports itself wrongly.
# LLM_INPUT_MODALITIES=text,image

# The context budget the runner trims tool results against. Leave it unset on
# OpenRouter: 80% of the model's own window is derived per model, so one .env
# fits every model. A value above the model's window is clamped to the derived
# one and the report says so. A trim is harness interference, so the goal is for
# trims never to happen.
# CONTEXT_BUDGET_TOKENS=500000
