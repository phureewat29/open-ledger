{
  "name": "@aquartier/openledger",
  "version": "0.21.1",
  "description": "OpenLedger — A deterministic ledger for your AI",
  "keywords": [
    "finance",
    "harness",
    "personal",
    "ledger",
    "bookkeeping",
    "cli",
    "ai"
  ],
  "homepage": "https://openledger.sh",
  "bugs": {
    "url": "https://github.com/phureewat29/openledger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phureewat29/openledger.git"
  },
  "license": "MIT",
  "author": "Phureewat A",
  "type": "module",
  "bin": {
    "oled": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    "datasets/",
    "plugin.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli/index.js",
    "test": "vitest run --typecheck --typecheck.tsconfig ./tsconfig.typecheck.json",
    "dev": "tsx src/cli/index.ts",
    "release": "tsx scripts/release.ts",
    "publish:skills": "tsx scripts/publish-skills.ts",
    "integration": "vitest run -c vitest.e2e.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "es-toolkit": "^1.50.0",
    "libsql": "^0.5.0",
    "mupdf": "^1.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws4fetch": "^1.0.20",
    "dotenv": "^16.4.0",
    "semver": "^7.8.4",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
